<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Machine-independent: paths resolve from $HOME inside sh -c (see happy plist).
     Install: launchctl bootstrap gui/$(id -u) ~/.deepclaude/launchd/local.deepclaude.proxy.plist -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.deepclaude.proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>exec &gt;&gt;"$HOME/Library/Logs/deepclaude-proxy.log" 2&gt;&amp;1 &amp;&amp; exec /bin/bash "$HOME/.deepclaude/bin/deepclaude-proxyd"</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
