#!/usr/bin/env bash
# Resident model-proxy for happy (launchd-managed, KeepAlive). Backend is fixed at
# start from CHEAPCLAUDE_DEFAULT_BACKEND (go/omni only — the case below duplicates
# resolve_backend() from repo/deepclaude.sh on purpose, so this never sources that
# script and loops back into a launcher).
set -euo pipefail
# launchd gives a minimal PATH; node lives in one of these on both machines.
export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

DC_HOME="${DC_HOME:-$HOME/.deepclaude}"
. "$DC_HOME/bin/lib-creds.sh"
load_cred OPENCODE_ZEN_API_KEY opencode
load_cred OMNIROUTE_DEEPCLAUDE_KEY omniroute

submodel=""; submaxout=""
BACKEND="${CHEAPCLAUDE_DEFAULT_BACKEND:-go}"
case "$BACKEND" in
    go|opencode-go)
        url="${OPENCODE_GO_URL:-https://opencode.ai/zen/go}"
        key="${OPENCODE_ZEN_API_KEY:-}"
        model="${OPENCODE_GO_MODEL:-deepseek-v4.1-flash}"
        ;;
    ci|cheaper|cheaperinference)
        echo "ERROR: backend 'ci' (CheaperInference) retired 2026-10-18; use 'go'." >&2
        exit 1
        ;;
    omni|omniroute)
        url="http://127.0.0.1:20128"
        key="${OMNIROUTE_DEEPCLAUDE_KEY:-}"
        model="${OMNIROUTE_MODEL:-free-tools}"
        ;;
    *)
        echo "ERROR: deepclaude-proxyd only supports go/omni, got '$BACKEND'" >&2
        exit 1
        ;;
esac
# Flash-only policy (2026-10-12): refuse DeepSeek Pro ids, including env overrides.
for _m in "$model" "$submodel"; do
    if [[ "$_m" =~ [Dd]eep[Ss]eek.*[Pp]ro ]]; then
        echo "ERROR: '$_m' is DeepSeek Pro; only DeepSeek Flash is allowed." >&2; exit 1
    fi
done
[[ -z "$key" ]] && { echo "ERROR: no API key for backend '$BACKEND'" >&2; exit 1; }

export DC_MODEL="$model"
# Split only when the subagent model differs (same rule as resolve_backend in
# repo/deepclaude.sh). Both are Flash now; setting it anyway made the proxy tag every
# happy main-loop call as subagent: subagent harness, no main harness, no loop guard.
if [[ -n "$submodel" && "$submodel" != "$model" ]]; then
    export DC_SUBAGENT_MODEL="$submodel" DC_SUBAGENT_MAX_OUTPUT="${submaxout:-}"
else
    export DC_SUBAGENT_MODEL="" DC_SUBAGENT_MAX_OUTPUT=""
fi
# Same default as the per-session proxy (repo/deepclaude.sh launch_claude).
export DC_LOOP_GUARD="${DC_LOOP_GUARD:-on}"
# Classifier short-circuit toggle for the resident proxy. off=forward classifier
# upstream (old abort-prone behavior); allow=answer <block>no</block> inline so
# Claude Code's auto-mode security-classifier never hits the cheap/agnese backend
# and never fails closed on long contexts.
export DC_CLASSIFIER_MODE="${DC_CLASSIFIER_MODE:-allow}"
# stdout is the port on legacy launch; launchd doesn't need it — discard.
# Key goes via env, never argv: `ps` output landed the value in 7 session transcripts
# (2026-09-12..16 audit). argv[3]="" makes start-proxy.js fall back to CHEAPCLAUDE_API_KEY.
export CHEAPCLAUDE_API_KEY="$key"
exec node "$DC_HOME/repo/proxy/start-proxy.js" "$url" "" --port "${DC_PROXY_PORT:-20133}" > /dev/null
