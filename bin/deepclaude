#!/usr/bin/env bash
# deepclaude launcher — shared between machines.
# Own CLAUDE_CONFIG_DIR (sessions/history/state separate from ~/.claude). No sync
# from ~/.claude at all: config/settings.json + config/CLAUDE.md are versioned here.
# Per-machine overrides use Claude Code's own project-local layer,
# work/.claude/settings.local.json (deep-merged on top, never committed) — seeded once
# from config/settings.local.$(id -un).json if that file exists.
set -euo pipefail

DC_HOME="${DC_HOME:-$HOME/.deepclaude}"
# launchd gives a minimal PATH; happy, claude and node live here.
export PATH="/opt/homebrew/bin:$HOME/.local/bin:/usr/local/bin:$PATH"
# happy/node may also live under nvm (not covered above).
_nvm_sh="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
_nvm_bin=""
if [[ -s "$_nvm_sh" ]]; then
    # official resolver: nvm handles lts/*, node and bare majors; --no-use leaves this shell's PATH alone
    _nvm_node="$(bash -c '. "$1" --no-use >/dev/null 2>&1 && nvm which default 2>/dev/null' _ "$_nvm_sh" || true)"
    [[ -n "$_nvm_node" ]] && _nvm_bin="$(dirname "$_nvm_node")"
fi
# no default alias / no nvm: newest installed still wins (fixindex 0848); no-op without nvm
[[ -z "$_nvm_bin" ]] && _nvm_bin=$(ls -d "$HOME/.nvm/versions/node/"*/bin 2>/dev/null | sort -V | tail -1 || true)
[[ -n "$_nvm_bin" ]] && PATH="$_nvm_bin:$PATH"
export PATH
CFG="${DC_CONFIG_DIR:-$DC_HOME/config}"

mkdir -p "$CFG" "$DC_HOME/work"
# cwd=$HOME would make ~/.claude/settings.json load as project settings on top of
# CLAUDE_CONFIG_DIR, leaking the main machine's hooks/plugins into the first turn.
[[ "$PWD" == "$HOME" ]] && cd "$DC_HOME/work"

. "$DC_HOME/bin/lib-creds.sh"
load_cred OPENCODE_ZEN_API_KEY opencode
# OpenRouter keys are reserved for other consumers (Jev / OpenClaw free router);
# deep runs on go. Drop any inherited copy so `-b or` fails loud instead of
# borrowing one.
unset OPENROUTER_API_KEY
load_cred OMNIROUTE_DEEPCLAUDE_KEY omniroute
load_cred DEEPSEEK_API_KEY deepseek
load_cred FIREWORKS_API_KEY fireworks
# search_web.py reads these from env; without them /research falls back to ddg/mojeek.
load_cred BRAVE_SEARCH_API_KEY brave
load_cred FIRECRAWL_API_KEY firecrawl

# Git hooks live in-repo (repo/tools/hooks) so both machines share one file, but
# core.hooksPath is per-clone config — set it once, here, so a fresh clone gets the
# pre-commit/post-commit hooks without a separate install step.
# A hooksPath inherited from global config must not be overridden — that would silently
# bypass it.
if [[ -d "$DC_HOME/.git" ]]; then
    _hp="$(git -C "$DC_HOME" config --get core.hooksPath 2>/dev/null || true)"
    [[ -n "$_hp" ]] || git -C "$DC_HOME" config core.hooksPath repo/tools/hooks || true
fi

# 派deep: the dispatching session is the MAIN ~/.claude, so the deep skill and the bare
# `deep-run`/`deep-lint` names it calls are linked there from this repo. Only a missing
# path or a stale symlink is (re)linked; a regular file in the way is a deliberate local
# stub (deep dispatch switched off on this machine) and is left alone.
for _l in "$HOME/.claude/skills/deep:$DC_HOME/skills/deep" \
          "$HOME/.local/bin/deep-run:$DC_HOME/bin/deep-run" \
          "$HOME/.local/bin/deep-lint:$DC_HOME/bin/deep-lint"; do
    _p="${_l%%:*}"; _t="${_l#*:}"
    if [[ ! -e "$_p" && ! -L "$_p" ]] || [[ -L "$_p" && "$(readlink "$_p")" != "$_t" ]]; then
        mkdir -p "$(dirname "$_p")" && ln -sfn "$_t" "$_p" \
            || echo "deepclaude: could not link $_p -> $_t" >&2
    fi
done

loc="$DC_HOME/work/.claude/settings.local.json"; seed="$DC_HOME/config/settings.local.$(id -un).json"
[[ -f "$loc" || ! -f "$seed" ]] || { mkdir -p "${loc%/*}" && cp "$seed" "$loc"; }
# Per-machine opt-in: mirror main ~/.claude tools (see bin/dc-sync-main). Runs before claude
# starts so claude's own .claude.json writes can't race it; a failure must not block launch.
[[ -f "$DC_HOME/work/.claude/.sync-main" ]] && { "$DC_HOME/bin/dc-sync-main" >&2 || echo "deepclaude: dc-sync-main failed" >&2; }

export CLAUDE_CONFIG_DIR="$CFG"
# Default backend: go = OpenCode Go (ci retired 2026-10-18). Main loop and subagents both
# deepseek-v4.1-flash (Flash only, Pro is refused) (see repo/deepclaude.sh). Override: `deepclaude -b omni` or env.
[[ -z "${CHEAPCLAUDE_DEFAULT_BACKEND:-}" && -s "$CFG/default-backend" ]] && CHEAPCLAUDE_DEFAULT_BACKEND="$(<"$CFG/default-backend")"
export CHEAPCLAUDE_DEFAULT_BACKEND="${CHEAPCLAUDE_DEFAULT_BACKEND:-go}"

# `deepclaude --setup`, or the first interactive launch with no key for the chosen backend:
# ask for one key and store it where load_cred reads it (~/.creds/kv/<VAR>.txt, mode 600).
# Read from stdin, never argv: argv shows up in `ps`.
backend_var() {
    case "$1" in
        ds|deepseek) echo DEEPSEEK_API_KEY ;;
        go|opencode-go) echo OPENCODE_ZEN_API_KEY ;;
        fw|fireworks) echo FIREWORKS_API_KEY ;;
    esac
}
dc_setup() {
    local b="${1:-}" c v k
    if [[ -z "$b" ]]; then
        echo "deepclaude setup: pick a backend"
        echo "  1) ds  DeepSeek official API, deepseek-v4-flash (recommended)  https://platform.deepseek.com/api_keys"
        echo "  2) go  OpenCode Go subscription, deepseek-v4.1-flash          https://opencode.ai"
        echo "  3) fw  Fireworks, deepseek-v4-flash                           https://fireworks.ai"
        read -rp "Choice [1]: " c || return 1
        case "${c:-1}" in 1|ds) b=ds ;; 2|go) b=go ;; 3|fw) b=fw ;; *) echo "deepclaude: unknown choice '$c'" >&2; return 1 ;; esac
    fi
    v="$(backend_var "$b")"
    [[ -n "$v" ]] || { echo "deepclaude: --setup supports ds/go/fw, got '$b'" >&2; return 1; }
    read -rsp "Paste $v (input hidden): " k || return 1; echo
    [[ -n "$k" ]] || { echo "deepclaude: empty key, nothing saved" >&2; return 1; }
    mkdir -p "$HOME/.creds/kv"
    ( umask 077; printf '%s' "$k" > "$HOME/.creds/kv/$v.txt" )
    printf '%s\n' "$b" > "$CFG/default-backend"
    export "$v=$k" CHEAPCLAUDE_DEFAULT_BACKEND="$b"
    echo "  saved ~/.creds/kv/$v.txt; default backend = $b (rerun: deepclaude --setup)"
}
if [[ "${1:-}" == "--setup" ]]; then dc_setup "${2:-}"; exit $?; fi
_b="$CHEAPCLAUDE_DEFAULT_BACKEND"; _prev=""
for _a in "$@"; do [[ "$_prev" == "-b" || "$_prev" == "--backend" ]] && _b="$_a"; _prev="$_a"; done
_v="$(backend_var "$_b")"
if [[ -n "$_v" && -z "${!_v:-}" && -t 0 && -t 1 ]]; then
    echo "deepclaude: no $_v yet, running setup once"
    dc_setup "$_b" || exit 1
fi

unset ANTHROPIC_API_KEY
exec "$DC_HOME/repo/deepclaude.sh" "$@"
